<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒 VPN" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_vpn_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_battery_level" android:padding="6dp" android:text="● Connected" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Singapore • 42ms" android:textColor="#CCFFFFFF" android:textSize="10sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_liquid_glass_border" android:padding="4dp" android:text="Tap to disconnect" android:textColor="#80FFFFFF" android:textSize="9sp"/>
</LinearLayout>
