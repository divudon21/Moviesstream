    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧘 Breathe" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="◯" android:textColor="#80C8FF" android:textSize="36sp"/>
    <TextView android:id="@+id/tv_breathe_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inhale • 4s" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_liquid_glass_border" android:padding="4dp" android:text="▶ Start Session" android:textColor="#FFFFFFFF" android:textSize="9sp"/>
</LinearLayout>
