<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_rounded"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏳ Countdown" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_countdown_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="05" android:textColor="#FFFFFFFF" android:textSize="38sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="days to Diwali" android:textColor="#CCFFFFFF" android:textSize="12sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_widget_cell" android:padding="4dp" android:text="25 Oct 2024" android:textColor="#FFFFFFFF" android:textSize="9sp"/>
</LinearLayout>
